<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/styles.css" />
    <title>Document</title>
  </head>
  <body>
    <a href="/">Back to Home</a>
    <div class="form-container">
      <form action="/signup" method="post" class="form">
        <label for="firstname">First name:</label>
        <input
          type="text"
          name="firstname"
          id="firstname"
          value="<%= locals.formData?.firstname || '' %>"
          required
        />
        <label for="lastname">Last name:</label>
        <input
          type="text"
          name="lastname"
          id="lastname"
          value="<%= locals.formData?.lastname || '' %>"
          required
        />
        <label for="email">Email:</label>
        <input
          type="email"
          name="email"
          id="email"
          value="<%= locals.formData?.email || '' %>"
          required
        />
        <label for="pwd">Password:</label>
        <input type="password" name="pwd" id="pwd" required />
        <label for="pwdconfirm">Confirm Password:</label>
        <input type="password" name="pwdconfirm" id="pwdconfirm" required />
        <button type="submit">SIGN UP</button>
      </form>
      <span class="text">Already registered?</span><a href="/signin">Sign in</a>
    </div>
    <h1>
      <%= locals.welcomeMessage || '' %>
    </h1>
    <% if (locals.errors?.length) { %>
    <ul class="validation-errors">
      <% errors.forEach((error) => { %>
      <li><%= error %></li>
      <% }) %>
    </ul>
    <% } %>
  </body>
</html>
